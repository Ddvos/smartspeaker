# Database
DATABASE_URL=postgresql://lampje:lampje_dev_password@localhost:5432/lampje

# Auth.js
AUTH_SECRET=  # Generate with: npx auth secret
AUTH_TRUST_HOST=true

# Google OAuth (https://console.cloud.google.com → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple OAuth (https://developer.apple.com → Certificates, Identifiers & Profiles)
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Gemini API - fallback key (https://aistudio.google.com/apikey)
# Users can set their own key in Settings; this is used as fallback
GEMINI_API_KEY=
